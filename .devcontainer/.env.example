# Provider credentials for pi inside the container.
# Copy to `.env` in this directory and fill in — `.env` is gitignored, never commit it.
# Loaded by podman via `--env-file .devcontainer/.env` (see README); only set what you need.
#
# Key for the local llama.cpp server — .devcontainer/models.json references
# $UNSLOTH_API_KEY. On this host the value lives in ~/.pi/agent/models.json
# (providers.unsloth.apiKey).
UNSLOTH_API_KEY=
# Other provider keys can be added here too, e.g.:
# ANTHROPIC_API_KEY=
